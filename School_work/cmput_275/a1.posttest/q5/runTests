#!/usr/bin/bash

command_arg="$1"  # The program to execute (e.g., ./divisors_sample)
test_set_file="$2"  # The file containing numbers to test (e.g., test1.in)

# Check if both arguments are provided
if [[ -z "$command_arg" || -z "$test_set_file" ]]; then
    echo "Usage: $0 <command_arg> <test_set_file>"
    exit 1
fi

# Read each number from the test set file
while read -r number; do
    # Run the program and capture its output
    output=$(${command_arg} <<< "$number")

    # Define the expected output file based on the input number
    expected_output_file="${number}.out"

    # Check if the expected output file exists
    if [[ ! -f "$expected_output_file" ]]; then
        echo "Expected output file ${expected_output_file} not found."
        continue
    fi

    # Create a temporary file for storing the program's output
    temp_file=$(mktemp)

    # Write the program's output to the temporary file
    echo "$output" > "$temp_file"

    # Compare the output with the expected output file
    if diff "$temp_file" "$expected_output_file" > /dev/null; then
        echo "Test with input ${number} passed"
    else
        echo "Test with input ${number} failed"
        echo "Expected output:"
        cat "$expected_output_file"
        echo "Actual output:"
        cat "$temp_file"
    fi

    # Clean up the temporary file
    rm "$temp_file"
done < "$test_set_file"
