#/bin/bash

if [ $# -eq 0 ]; then 
    echo 'Usage ./testDescribe testsetfile' >&2
    exit
fi

while read -r line; do 
    stems=( $line )
    length=$((${#stems[@]}-1))


    for ((i=0;i<=length;i++));do
        ABS_PATH="${PWD}/${stems[i]}.desc"
        if [[ -e ${stems[i]}.desc || -e ABS_PATH ]]; then 
            echo "$(cat ${stems[i]}.desc)"
        else
            echo "${stems[i]} No test description"
        fi

    done


done < $1
exit 1